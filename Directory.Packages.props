<Project>

  <!-- Central Package Management: every NuGet version is pinned here, once, for
       all projects. Project files reference packages WITHOUT a Version attribute.
       This is the file you edit to bump a dependency. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Product">
    <!-- Evaluated 4.2.751201 on 2026-11-25 and stayed on 3.x: the suite is green on 4.x (Windows and Linux), but 4.x
         ships Azure.Identity, Azure.Core, MSAL and Microsoft.Security.AntiSSRF (about +1 MB nupkg, 8 extra DLLs; Azure.Core and
         AntiSSRF are loaded on the live-attach path) for symbol-server features this tool does not use, and no 4.x fix addresses a
         defect seen here. Revisit if a target runtime (e.g. .NET 11) needs the newer heap/DAC support. -->
    <PackageVersion Include="Microsoft.Diagnostics.Runtime" Version="3.1.512801" />
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageVersion Include="System.Management" Version="10.0.15" />
  </ItemGroup>

  <!-- Used only by the historical spike/ probes (not built by the solution). -->
  <ItemGroup Label="Spike">
    <PackageVersion Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.661903" />
  </ItemGroup>

  <!-- Stay on xunit v2 + VSTest: the product's debug_test feature drives VSTest. -->
  <ItemGroup Label="Test">
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

</Project>
