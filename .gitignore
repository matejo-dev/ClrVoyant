# Build output
[Bb]in/
[Oo]bj/
[Oo]ut/
artifacts/
*.user
*.suo
.vs/

# NuGet / tool packaging output
*.nupkg
nupkg/
.nupkg*/
.tool*/

# Test / coverage output
[Tt]est[Rr]esults/
coverage-report/
coverage*.json
coverage*.xml
*.coverage
*.trx

# netcoredbg is fetched at build time (pinned version + SHA-256 verified) by the
# FetchNetcoredbg MSBuild target — never committed (MIT, large third-party binary).
# Match at ANY depth: the build cache (tools/netcoredbg/) AND the spike's own
# fetched copy (spike/tools/netcoredbg/). A leading **/ is required because a
# mid-pattern slash would otherwise anchor it to the repo root.
**/tools/netcoredbg/
# The downloaded engine ARCHIVES (siblings of the extracted dir, so not covered
# by the rule above) — e.g. netcoredbg-win64.zip, netcoredbg-linux-amd64.tar.gz.
**/netcoredbg-*.zip
**/netcoredbg-*.tar.gz
# The spike's entire download scratch dir (only ever holds the fetched engine).
/spike/tools/

# Spike scratch: downloaded engine + published server output (regenerated by run.ps1)
/spike/linux/.netcoredbg/
/spike/linux/.server/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
