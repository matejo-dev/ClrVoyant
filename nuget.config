<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Repo-local feed config: this project depends only on public packages.
    We clear any inherited (machine/user) sources so restore does not hit
    private feeds (e.g. the org Azure Artifacts feed) that require auth and
    would otherwise fail restore in clean environments.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
