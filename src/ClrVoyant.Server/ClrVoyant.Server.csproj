<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ClrVoyant.Core\ClrVoyant.Core.csproj" />
    <ProjectReference Include="..\ClrVoyant.Dap\ClrVoyant.Dap.csproj" />
    <ProjectReference Include="..\ClrVoyant.Inspection\ClrVoyant.Inspection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClrVoyant.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- No PlatformTarget pin (AnyCPU): the server runs at the host architecture so
         the in-process ClrMD inspector and netcoredbg match the co-located target.
         Supported hosts/targets: win-x64, linux-x64, linux-arm64. -->
  </PropertyGroup>

  <!-- Distributable as a .NET global tool: `dotnet tool install -g ClrVoyant` gives
       an `clrvoyant` command on PATH (no bin/Release paths in client config). -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>clrvoyant</ToolCommandName>
    <PackageId>ClrVoyant</PackageId>
    <IsPackable>true</IsPackable>
    <Version>0.2.0</Version>
    <Description>A local MCP server that lets an agent debug .NET 8/9/10 apps headlessly — breakpoints, stepping, variables, and full async Task introspection (the "Tasks window" via ClrMD).</Description>
    <PackageTags>mcp;debugger;dotnet;netcoredbg;clrmd;async;tasks</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Pinned netcoredbg coordinates baked into the assembly so the runtime fetch
       (NetcoredbgFetcher, used when running as an installed tool with no bundled
       copy) knows exactly what to download for the current OS + architecture. -->
  <ItemGroup>
    <AssemblyMetadata Include="NetcoredbgVersion" Value="$(NetcoredbgVersion)" />
    <AssemblyMetadata Include="NetcoredbgSha256Windows" Value="$(NetcoredbgSha256Windows)" />
    <AssemblyMetadata Include="NetcoredbgSha256Linux" Value="$(NetcoredbgSha256Linux)" />
    <AssemblyMetadata Include="NetcoredbgSha256LinuxArm64" Value="$(NetcoredbgSha256LinuxArm64)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- netcoredbg is fetched at build time (pinned version, SHA-256 verified) into
       a local cache under tools/netcoredbg/, then bundled next to the server where
       NetcoredbgLocator finds it. It is NOT committed to the repo (MIT, large
       binary). The download runs ONLY when the cache is missing, so a fresh clone
       fetches once and later builds skip it. Version/hashes are pinned in
       Directory.Build.props (single source of truth). See THIRD-PARTY-NOTICES.md. -->

  <!-- Populate the cache (only when missing). -->
  <Target Name="FetchNetcoredbg" BeforeTargets="Build;Publish">
    <Exec Condition="!Exists('$(NetcoredbgCacheDir)\$(NetcoredbgExeName)') And $([MSBuild]::IsOSPlatform('Windows'))"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepoToolsDir)\fetch-netcoredbg.ps1&quot; -Version $(NetcoredbgVersion) -Sha256 $(NetcoredbgSha256) -DestDir &quot;$(NetcoredbgCacheDir)&quot;" />
    <Exec Condition="!Exists('$(NetcoredbgCacheDir)/$(NetcoredbgExeName)') And !$([MSBuild]::IsOSPlatform('Windows'))"
          Command="bash &quot;$(RepoToolsDir)/fetch-netcoredbg.sh&quot; $(NetcoredbgVersion) $(NetcoredbgSha256) &quot;$(NetcoredbgCacheDir)&quot;" />
  </Target>

  <!-- Bundle the cache next to the server (build output and publish output), where
       NetcoredbgLocator finds it. Explicit Copy with a destination transform is
       robust across OSes and for items produced during the build. -->
  <Target Name="BundleNetcoredbgToOutput" AfterTargets="Build" DependsOnTargets="FetchNetcoredbg">
    <ItemGroup>
      <_Netcoredbg Include="$(NetcoredbgCacheDir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_Netcoredbg)"
          DestinationFiles="@(_Netcoredbg->'$(OutDir)tools\netcoredbg\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish/pack bundle the engine for EVERY supported RID under
       tools/netcoredbg/<rid>/, so the .NET global tool works offline on any
       supported host with no runtime download (NetcoredbgLocator picks the
       matching <rid>). The non-host RIDs are downloaded here at publish time
       (SHA-256 verified) using only built-in MSBuild tasks — no PowerShell/bash —
       so it also runs inside the dotnet/sdk container image. This is build-time
       network access (CI / the packager), never the end user's machine. -->
  <Target Name="StageNetcoredbgRidsToPublish" AfterTargets="Publish">
    <MSBuild Projects="$(MSBuildThisFileFullPath)" Targets="StageOneNetcoredbgRid"
             Properties="StageRid=win-x64;StageAsset=netcoredbg-win64.zip;StageSha=$(NetcoredbgSha256Windows);StageExe=netcoredbg.exe;StageIsZip=true;StageDestRoot=$(PublishDir)tools/netcoredbg" />
    <MSBuild Projects="$(MSBuildThisFileFullPath)" Targets="StageOneNetcoredbgRid"
             Properties="StageRid=linux-x64;StageAsset=netcoredbg-linux-amd64.tar.gz;StageSha=$(NetcoredbgSha256Linux);StageExe=netcoredbg;StageIsZip=false;StageDestRoot=$(PublishDir)tools/netcoredbg" />
    <MSBuild Projects="$(MSBuildThisFileFullPath)" Targets="StageOneNetcoredbgRid"
             Properties="StageRid=linux-arm64;StageAsset=netcoredbg-linux-arm64.tar.gz;StageSha=$(NetcoredbgSha256LinuxArm64);StageExe=netcoredbg;StageIsZip=false;StageDestRoot=$(PublishDir)tools/netcoredbg" />

    <!-- Drop the single-RID flat copy that the build-output bundle leaves in publish:
         the package ships the per-RID layout only (no redundant host-RID duplicate).
         '*' matches top-level files but does not recurse into the <rid>/ subdirs. -->
    <ItemGroup>
      <_FlatNetcoredbg Include="$(PublishDir)tools/netcoredbg/*" />
    </ItemGroup>
    <Delete Files="@(_FlatNetcoredbg)" />
  </Target>

  <!-- Stage one RID's netcoredbg into $(StageDestRoot)/$(StageRid)/. Idempotent:
       skips entirely if the binary is already present. Parametrized via the MSBuild
       task above so the download/verify/extract logic lives in exactly one place. -->
  <Target Name="StageOneNetcoredbgRid"
          Condition="!Exists('$(StageDestRoot)/$(StageRid)/$(StageExe)')">
    <PropertyGroup>
      <_StageTmp>$(IntermediateOutputPath)ncdbg-stage/$(StageRid)</_StageTmp>
      <_StageUrl>https://github.com/Samsung/netcoredbg/releases/download/$(NetcoredbgVersion)/$(StageAsset)</_StageUrl>
    </PropertyGroup>
    <RemoveDir Directories="$(_StageTmp)" />
    <MakeDir Directories="$(_StageTmp)" />

    <DownloadFile SourceUrl="$(_StageUrl)" DestinationFolder="$(_StageTmp)" Retries="3">
      <Output TaskParameter="DownloadedFile" PropertyName="_StageArchive" />
    </DownloadFile>

    <GetFileHash Files="$(_StageArchive)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_StageGotSha" />
    </GetFileHash>
    <!-- MSBuild '==' on strings is case-insensitive, so hex-case differences are fine. -->
    <Error Condition="'$(_StageGotSha)' != '$(StageSha)'"
           Text="netcoredbg checksum mismatch for $(StageAsset): expected $(StageSha), got $(_StageGotSha)." />

    <!-- .zip via the built-in Unzip task; .tar.gz via tar (present on Windows 10+,
         Linux, and the dotnet SDK image — there is no built-in tar MSBuild task).
         tar's -C target must exist first; Unzip creates its destination itself. -->
    <MakeDir Directories="$(_StageTmp)/x" />
    <Unzip Condition="'$(StageIsZip)' == 'true'" SourceFiles="$(_StageArchive)" DestinationFolder="$(_StageTmp)/x" />
    <Exec Condition="'$(StageIsZip)' != 'true'" Command="tar -xzf &quot;$(_StageArchive)&quot; -C &quot;$(_StageTmp)/x&quot;" />

    <!-- The upstream archive nests everything under a netcoredbg/ folder; promote its
         contents to tools/netcoredbg/<rid>/ where the locator looks. -->
    <ItemGroup>
      <_StageFiles Include="$(_StageTmp)/x/netcoredbg/**/*" />
    </ItemGroup>
    <Error Condition="'@(_StageFiles)' == ''" Text="netcoredbg/ folder not found inside $(StageAsset)." />
    <Copy SourceFiles="@(_StageFiles)"
          DestinationFiles="@(_StageFiles->'$(StageDestRoot)/$(StageRid)/%(RecursiveDir)%(Filename)%(Extension)')" />
    <RemoveDir Directories="$(_StageTmp)" />
  </Target>

</Project>
