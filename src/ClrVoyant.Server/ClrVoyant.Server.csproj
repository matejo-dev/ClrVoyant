<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ClrVoyant.Core\ClrVoyant.Core.csproj" />
    <ProjectReference Include="..\ClrVoyant.Dap\ClrVoyant.Dap.csproj" />
    <ProjectReference Include="..\ClrVoyant.Inspection\ClrVoyant.Inspection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClrVoyant.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- A global tool runs on whatever runtime the machine has. Without this, a
         net10.0 tool refuses to start on a machine that only has a newer runtime
         (e.g. .NET 11); Major lets it roll forward. Debug TARGETS are unaffected. -->
    <RollForward>Major</RollForward>
    <!-- No PlatformTarget pin (AnyCPU): the server runs at the host architecture so
         the in-process ClrMD inspector and netcoredbg match the co-located target.
         Supported hosts/targets: win-x64, linux-x64, linux-arm64. -->
  </PropertyGroup>

  <!-- Distributable as a .NET global tool: `dotnet tool install -g ClrVoyant` gives
       an `clrvoyant` command on PATH (no bin/Release paths in client config). -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>clrvoyant</ToolCommandName>
    <PackageId>ClrVoyant</PackageId>
    <IsPackable>true</IsPackable>
    <Version>0.2.1</Version>
    <Description>A local MCP server that lets an agent debug .NET 8/9/10 apps headlessly — breakpoints, stepping, variables, and full async Task introspection (the "Tasks window" via ClrMD).</Description>
    <PackageTags>mcp;debugger;dotnet;netcoredbg;clrmd;async;tasks</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Symbol package (.snupkg) next to the tool, for source-level debugging of it. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Pinned netcoredbg coordinates baked into the assembly so the runtime fetch
       (NetcoredbgFetcher, used when running as an installed tool with no bundled
       copy) knows exactly what to download for the current OS + architecture. -->
  <ItemGroup>
    <AssemblyMetadata Include="NetcoredbgVersionWindows" Value="$(NetcoredbgVersionWindows)" />
    <AssemblyMetadata Include="NetcoredbgVersionLinux" Value="$(NetcoredbgVersionLinux)" />
    <AssemblyMetadata Include="NetcoredbgSha256Windows" Value="$(NetcoredbgSha256Windows)" />
    <AssemblyMetadata Include="NetcoredbgSha256Linux" Value="$(NetcoredbgSha256Linux)" />
    <AssemblyMetadata Include="NetcoredbgSha256LinuxArm64" Value="$(NetcoredbgSha256LinuxArm64)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The package redistributes netcoredbg (MIT, notice required): ship the licence
         and the third-party notices alongside the readme. -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- netcoredbg is fetched at build time (pinned version, SHA-256 verified) into
       a local cache under tools/netcoredbg/, then bundled next to the server where
       NetcoredbgLocator finds it. It is NOT committed to the repo (MIT, large
       binary). The download runs ONLY when the cache is missing or holds another
       version (checked via the $(NetcoredbgStampName) marker), so a fresh clone
       fetches once, later builds skip it, and a version bump refetches.
       Version/hashes are pinned in Directory.Build.props (single source of truth).
       See THIRD-PARTY-NOTICES.md. -->

  <!-- Populate the cache (only when missing or stale). -->
  <Target Name="FetchNetcoredbg" BeforeTargets="Build;Publish">
    <Exec Condition="(!Exists('$(NetcoredbgCacheDir)\$(NetcoredbgExeName)') Or !Exists('$(NetcoredbgCacheDir)\$(NetcoredbgStampName)')) And $([MSBuild]::IsOSPlatform('Windows'))"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepoToolsDir)\fetch-netcoredbg.ps1&quot; -Version $(NetcoredbgVersion) -Sha256 $(NetcoredbgSha256) -DestDir &quot;$(NetcoredbgCacheDir)&quot;" />
    <Exec Condition="(!Exists('$(NetcoredbgCacheDir)/$(NetcoredbgExeName)') Or !Exists('$(NetcoredbgCacheDir)/$(NetcoredbgStampName)')) And !$([MSBuild]::IsOSPlatform('Windows'))"
          Command="bash &quot;$(RepoToolsDir)/fetch-netcoredbg.sh&quot; $(NetcoredbgVersion) $(NetcoredbgSha256) &quot;$(NetcoredbgCacheDir)&quot;" />
  </Target>

  <!-- Bundle the cache next to the server (build output and publish output), where
       NetcoredbgLocator finds it. Explicit Copy with a destination transform is
       robust across OSes and for items produced during the build. -->
  <Target Name="BundleNetcoredbgToOutput" AfterTargets="Build" DependsOnTargets="FetchNetcoredbg">
    <ItemGroup>
      <_Netcoredbg Include="$(NetcoredbgCacheDir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_Netcoredbg)"
          DestinationFiles="@(_Netcoredbg->'$(OutDir)tools\netcoredbg\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish/pack bundle the engine for EVERY supported RID under
       tools/netcoredbg/<rid>/, so the .NET global tool works offline on any
       supported host with no runtime download (NetcoredbgLocator picks the
       matching <rid>). The engines are downloaded here at publish time (SHA-256
       verified) using only built-in MSBuild tasks — no PowerShell/bash — so it also
       runs inside the dotnet/sdk container image. This is build-time network access
       (CI / the packager), never the end user's machine.
       They are staged under obj/ and handed to the SDK as ResolvedFileToPublish
       items, the list both the publish copy and the tool pack consume (SDK 8 packs
       from the items, SDK 10 globs the publish dir they are copied to). Copying them
       into the publish dir on the side instead only reached the package on SDKs
       that glob, and only when the hook happened to run. -->
  <Target Name="StageNetcoredbgRidsToPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <PropertyGroup>
      <_NetcoredbgRidsDir>$(BaseIntermediateOutputPath)netcoredbg-rids</_NetcoredbgRidsDir>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildThisFileFullPath)" Targets="StageOneNetcoredbgRid"
             Properties="StageRid=win-x64;StageVersion=$(NetcoredbgVersionWindows);StageAsset=netcoredbg-win64.zip;StageSha=$(NetcoredbgSha256Windows);StageExe=netcoredbg.exe;StageIsZip=true;StageDestRoot=$(_NetcoredbgRidsDir)" />
    <MSBuild Projects="$(MSBuildThisFileFullPath)" Targets="StageOneNetcoredbgRid"
             Properties="StageRid=linux-x64;StageVersion=$(NetcoredbgVersionLinux);StageAsset=netcoredbg-linux-amd64.tar.gz;StageSha=$(NetcoredbgSha256Linux);StageExe=netcoredbg;StageIsZip=false;StageDestRoot=$(_NetcoredbgRidsDir)" />
    <MSBuild Projects="$(MSBuildThisFileFullPath)" Targets="StageOneNetcoredbgRid"
             Properties="StageRid=linux-arm64;StageVersion=$(NetcoredbgVersionLinux);StageAsset=netcoredbg-linux-arm64.tar.gz;StageSha=$(NetcoredbgSha256LinuxArm64);StageExe=netcoredbg;StageIsZip=false;StageDestRoot=$(_NetcoredbgRidsDir)" />
    <!-- A publish dir is not cleaned between publishes and this subtree is ours: start
         it fresh, so nothing from an older pin lingers next to the copied engines. -->
    <RemoveDir Directories="$(PublishDir)tools/netcoredbg" />
    <ItemGroup>
      <_StagedNetcoredbg Include="$(_NetcoredbgRidsDir)/**/*" />
      <ResolvedFileToPublish Include="@(_StagedNetcoredbg)"
                             RelativePath="tools/netcoredbg/%(_StagedNetcoredbg.RecursiveDir)%(_StagedNetcoredbg.Filename)%(_StagedNetcoredbg.Extension)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- Fail closed on the ARTIFACT: a tool package must bundle the engine for every
       supported RID. Checked by opening the produced .nupkg rather than by trusting
       the pipeline, so an SDK whose publish/pack graph skips or bypasses the staging
       above fails the pack instead of shipping a package that installs fine and
       cannot find its engine. -->
  <Target Name="VerifyNetcoredbgRidsInPackage" AfterTargets="Pack" Condition="'$(PackAsTool)' == 'true'">
    <PropertyGroup>
      <_NupkgVerifyDir>$(IntermediateOutputPath)nupkg-verify</_NupkgVerifyDir>
    </PropertyGroup>
    <ItemGroup>
      <_PackedNupkg Include="@(NuGetPackOutput)" Condition="'%(Extension)' == '.nupkg'" />
    </ItemGroup>
    <RemoveDir Directories="$(_NupkgVerifyDir)" />
    <Unzip SourceFiles="@(_PackedNupkg)" DestinationFolder="$(_NupkgVerifyDir)" />
    <ItemGroup>
      <_PackedEngineWinX64 Include="$(_NupkgVerifyDir)/tools/*/any/tools/netcoredbg/win-x64/netcoredbg.exe" />
      <_PackedEngineLinuxX64 Include="$(_NupkgVerifyDir)/tools/*/any/tools/netcoredbg/linux-x64/netcoredbg" />
      <_PackedEngineLinuxArm64 Include="$(_NupkgVerifyDir)/tools/*/any/tools/netcoredbg/linux-arm64/netcoredbg" />
    </ItemGroup>
    <PropertyGroup>
      <_PackedEnginesComplete Condition="'@(_PackedEngineWinX64)' != '' And '@(_PackedEngineLinuxX64)' != '' And '@(_PackedEngineLinuxArm64)' != ''">true</_PackedEnginesComplete>
    </PropertyGroup>
    <RemoveDir Directories="$(_NupkgVerifyDir)" />
    <Delete Condition="'$(_PackedEnginesComplete)' != 'true'" Files="@(_PackedNupkg)" />
    <Error Condition="'$(_PackedEnginesComplete)' != 'true'"
           Text="@(_PackedNupkg) did not bundle netcoredbg for every supported RID (win-x64, linux-x64, linux-arm64) under tools/netcoredbg/; the package was deleted." />
  </Target>

  <!-- Stage one RID's netcoredbg into $(StageDestRoot)/$(StageRid)/. Idempotent:
       skips entirely if the binary AND the marker for the pinned version are already
       present, so a folder staged for an older pin is replaced, not reused.
       Parametrized via the MSBuild task above so the download/verify/extract logic
       lives in exactly one place. -->
  <Target Name="StageOneNetcoredbgRid"
          Condition="!Exists('$(StageDestRoot)/$(StageRid)/$(StageExe)') Or !Exists('$(StageDestRoot)/$(StageRid)/netcoredbg-$(StageVersion).stamp')">
    <PropertyGroup>
      <_StageTmp>$(IntermediateOutputPath)ncdbg-stage/$(StageRid)</_StageTmp>
      <_StageUrl>https://github.com/Samsung/netcoredbg/releases/download/$(StageVersion)/$(StageAsset)</_StageUrl>
    </PropertyGroup>
    <RemoveDir Directories="$(_StageTmp)" />
    <MakeDir Directories="$(_StageTmp)" />

    <DownloadFile SourceUrl="$(_StageUrl)" DestinationFolder="$(_StageTmp)" Retries="3">
      <Output TaskParameter="DownloadedFile" PropertyName="_StageArchive" />
    </DownloadFile>

    <GetFileHash Files="$(_StageArchive)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_StageGotSha" />
    </GetFileHash>
    <!-- MSBuild '==' on strings is case-insensitive, so hex-case differences are fine. -->
    <Error Condition="'$(_StageGotSha)' != '$(StageSha)'"
           Text="netcoredbg checksum mismatch for $(StageAsset): expected $(StageSha), got $(_StageGotSha)." />

    <!-- .zip via the built-in Unzip task; .tar.gz via tar (present on Windows 10+,
         Linux, and the dotnet SDK image — there is no built-in tar MSBuild task).
         tar's -C target must exist first; Unzip creates its destination itself.
         tar runs from the staging folder with RELATIVE paths: GNU tar (e.g. Git for
         Windows' tar, first on PATH in Git Bash) reads a "c:\..." archive path as a
         remote host:path, while relative names work with both GNU tar and bsdtar. -->
    <MakeDir Directories="$(_StageTmp)/x" />
    <Unzip Condition="'$(StageIsZip)' == 'true'" SourceFiles="$(_StageArchive)" DestinationFolder="$(_StageTmp)/x" />
    <Exec Condition="'$(StageIsZip)' != 'true'" WorkingDirectory="$(_StageTmp)"
          Command="tar -xzf &quot;$(StageAsset)&quot; -C x" />

    <!-- The upstream archive nests everything under a netcoredbg/ folder; promote its
         contents to tools/netcoredbg/<rid>/ where the locator looks. -->
    <ItemGroup>
      <_StageFiles Include="$(_StageTmp)/x/netcoredbg/**/*" />
    </ItemGroup>
    <Error Condition="'@(_StageFiles)' == ''" Text="netcoredbg/ folder not found inside $(StageAsset)." />
    <!-- Replace (not merge into) a previously staged version, then mark this one. -->
    <RemoveDir Directories="$(StageDestRoot)/$(StageRid)" />
    <Copy SourceFiles="@(_StageFiles)"
          DestinationFiles="@(_StageFiles->'$(StageDestRoot)/$(StageRid)/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Touch Files="$(StageDestRoot)/$(StageRid)/netcoredbg-$(StageVersion).stamp" AlwaysCreate="true" />
    <RemoveDir Directories="$(_StageTmp)" />
  </Target>

</Project>
