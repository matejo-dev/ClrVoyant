<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- This app exists only to be a debug TARGET for the integration tests. Keep
         it debug-friendly in EVERY configuration: no optimization (so the JIT
         doesn't move/elide the breakpoint line) and portable PDBs (source lines).
         Without this, a Release build makes breakpoints miss and the tests that
         require a stopped target fail ("Running, not stopped"). -->
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

</Project>
