<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- No PlatformTarget pin (AnyCPU): tests run at the host architecture, so the
         in-process ClrMD inspector matches the target the integration tests launch
         (which is built for the same host). Supported: x64 and arm64. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClrVoyant.Core\ClrVoyant.Core.csproj" />
    <ProjectReference Include="..\..\src\ClrVoyant.Dap\ClrVoyant.Dap.csproj" />
    <ProjectReference Include="..\..\src\ClrVoyant.Inspection\ClrVoyant.Inspection.csproj" />
    <ProjectReference Include="..\..\src\ClrVoyant.Server\ClrVoyant.Server.csproj" />
  </ItemGroup>

  <!-- The integration tests launch the sample debuggees as separate processes, so the
       test assembly must not reference their assemblies (ReferenceOutputAssembly=false),
       but they must be built before the tests run and restored with the same graph.
       The reference makes a plain `dotnet test` of this project build them, and the
       target below builds every target framework the tests debug (a ProjectReference
       alone would only build the one matching this project's TFM). WinFormsApp is
       Windows-only, so it is built (for the native-frames test) only on Windows. -->
  <ItemGroup>
    <ProjectReference Include="..\..\samples\SampleApp\SampleApp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\samples\ParentApp\ParentApp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\samples\WinFormsApp\WinFormsApp.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true"
                      Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <Target Name="BuildSampleDebuggeeTfms" AfterTargets="ResolveProjectReferences">
    <ItemGroup>
      <_DebuggeeProject Include="..\..\samples\SampleApp\SampleApp.csproj;..\..\samples\ParentApp\ParentApp.csproj" />
    </ItemGroup>
    <MSBuild Projects="@(_DebuggeeProject)" Targets="Build" Properties="TargetFramework=net8.0" />
    <MSBuild Projects="@(_DebuggeeProject)" Targets="Build" Properties="TargetFramework=net9.0" />
    <MSBuild Projects="@(_DebuggeeProject)" Targets="Build" Properties="TargetFramework=net10.0" />
  </Target>

</Project>
