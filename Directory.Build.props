<Project>

  <!-- Common settings for every project in the repo (auto-imported by MSBuild).
       Individual projects may still override any of these. -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Fail the build on any warning, so warnings can't quietly accumulate. The SDK
         band is pinned by global.json, so the analyzer set is stable; an SDK bump
         that surfaces new warnings is a deliberate, fixable event. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Authorship / packaging metadata (applies if a project opts into packing).
         Most projects are not packable; the deliverable is ClrVoyant.Server. -->
    <Authors>Matteo Panzacchi</Authors>
    <Product>ClrVoyant</Product>
    <Copyright>Copyright (c) 2026 Matteo Panzacchi</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/matejo-dev/ClrVoyant</PackageProjectUrl>
    <RepositoryUrl>https://github.com/matejo-dev/ClrVoyant.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>false</IsPackable>

    <!-- Reproducible, source-linked packages for nuget.org. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Report vulnerable packages including transitive ones (default is direct only). -->
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <!-- Deterministic paths in the PDBs/package only on CI (it breaks local debugging). -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- netcoredbg is fetched at build time (pinned + SHA-256 verified) by the
       FetchNetcoredbg target in ClrVoyant.Server. This is the SINGLE SOURCE OF
       TRUTH for the version/hashes; keep tools/fetch-netcoredbg.* and the spike
       scripts in sync with it. -->
  <PropertyGroup Label="netcoredbg">
    <NetcoredbgVersion>3.2.0-1092</NetcoredbgVersion>
    <!-- Per-OS/arch pinned SHA-256 of the upstream asset. Supported targets:
         win-x64, linux-x64, linux-arm64 (netcoredbg ships no win-arm64; its osx-arm64
         build is not a supported target, see ADR-0011). -->
    <NetcoredbgSha256Windows>3c410a45fa502415203a94fcb88654af65bf8e3dac158a5527a722e7a6b9274a</NetcoredbgSha256Windows>
    <NetcoredbgSha256Linux>080eb3b2d2152465f599d3b33d1ee6e747794e11cc0a3773ec689f5e5f2c5afa</NetcoredbgSha256Linux>
    <NetcoredbgSha256LinuxArm64>065ff49badec8a695dbea2de6ab6a330c774a191e426a217ab8cc05250627ccb</NetcoredbgSha256LinuxArm64>
    <!-- Marker written next to a fetched/staged engine. Its NAME carries the version, so
         a cache populated for an older pin is detected as stale and refetched after a
         bump (existence of the binary alone says nothing about its version). The fetch
         scripts derive the same name from the version they are given. -->
    <NetcoredbgStampName>netcoredbg-$(NetcoredbgVersion).stamp</NetcoredbgStampName>
    <RepoToolsDir>$(MSBuildThisFileDirectory)tools</RepoToolsDir>
    <NetcoredbgCacheDir>$(RepoToolsDir)\netcoredbg</NetcoredbgCacheDir>
    <!-- Architecture of the current build process. The build-time fetch bundles the
         engine for THIS arch (an emulated arm64 container build reports Arm64), and
         the runtime fetch keys off the running process arch the same way. -->
    <NetcoredbgArch>$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)</NetcoredbgArch>
    <NetcoredbgExeName Condition="$([MSBuild]::IsOSPlatform('Windows'))">netcoredbg.exe</NetcoredbgExeName>
    <NetcoredbgExeName Condition="!$([MSBuild]::IsOSPlatform('Windows'))">netcoredbg</NetcoredbgExeName>
    <NetcoredbgSha256 Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(NetcoredbgSha256Windows)</NetcoredbgSha256>
    <NetcoredbgSha256 Condition="!$([MSBuild]::IsOSPlatform('Windows')) And '$(NetcoredbgArch)' == 'Arm64'">$(NetcoredbgSha256LinuxArm64)</NetcoredbgSha256>
    <NetcoredbgSha256 Condition="!$([MSBuild]::IsOSPlatform('Windows')) And '$(NetcoredbgArch)' != 'Arm64'">$(NetcoredbgSha256Linux)</NetcoredbgSha256>
  </PropertyGroup>

</Project>
